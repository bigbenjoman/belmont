# Build output
dist/
/belmont

# Embedded content (copied by build script, cleaned up after)
cmd/belmont/skills/
cmd/belmont/agents/

# Generated skill folders (Phase 2: produced by scripts/generate-skills.sh from
# _src/ + _partials/ — not committed, regenerated on `go generate ./...` or
# auto-regenerated by source-mode `belmont install`).
skills/belmont/*/
!skills/belmont/_src/
!skills/belmont/_partials/

# Local belmont install artifacts
.belmont/bin/
.belmont/cache/

# Local Claude settings
.claude/

# Raw research notes — inputs to deliverables, not deliverables.
# Kept on disk so agents can read the evidence; not committed.
_research/
.belmont/auto.json
.belmont/worktrees/

# Self-hosting: `belmont install --source .` in this repo copies agents/ and the
# generated skills/ onto the .agents/ surface. Byte-identical to in-repo source,
# so committing it would keep two copies of our own prose that drift apart.
.agents/

# macOS
.DS_Store
